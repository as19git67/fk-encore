.git
.gitignore
.idea
.encore/build
.env
node_modules
# Python Services (separate images)
embedding_service
insightface-service
landmark-service

# Frontend
frontend/node_modules
# NOTE: frontend/dist is deliberately NOT ignored. The CI/CD builds the SPA
# on the host (`npm --prefix frontend run build`) before `docker build`, and
# docker/Dockerfile.runtime copies it into /srv/frontend/dist inside the
# image. Ignoring it would break the Stage B build.

# Tests and Test Configuration
vitest.config.ts
vitest.setup.ts
vitest.globalsetup.ts
drizzle.config.ts
**/*.test.ts
**/*.spec.ts

# Configuration and scripts
scripts
# Exception: the host-side backup hook files are COPYed into the runtime
# image by docker/Dockerfile.runtime and seeded onto the backup volume at
# container start (see backup/startup.ts). They must be part of the build
# context.
!scripts/host
!scripts/host/install-backup-hook.sh
!scripts/host/fk-encore-backup.sh
!scripts/host/README.md
test_output.txt
tsconfig.tsbuildinfo
data
uploads
.DS_Store
