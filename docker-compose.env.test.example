# ──────────────────────────────────────────────────────────────────────────────
# fk-encore — Docker Compose TEST deployment template
# ──────────────────────────────────────────────────────────────────────────────
#
# Copy to `.env` (or `.env.test`) in the test stack's directory and bring
# up with:
#   docker compose --env-file .env.test up -d
#
# Only the values that differ from production are listed — everything
# else inherits the defaults baked into `docker-compose.yml`. See
# `docker-compose.env.example` for the full reference of available
# variables and their defaults.
#
# Purpose: run the `:test`-tagged stack (every PR push lands here) next to
# the `:latest` production stack on the same Docker host, on a COPY OF
# PRODUCTION: its data directory is a ZFS clone of prod's newest nightly
# snapshot, replaced weekly by scripts/host/test-refresh.sh
# (documentation/plans/dev-system.md, DEPLOYMENT.md › "Test stack").
# Container names, host ports and the watchtower label are distinct from
# prod; docker-compose.test.yml keeps mail, push and every paid API away
# from real people and accounts.

# ────────────────────────────────────────────────────────────────────────────
# Deployment identity
# ────────────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=fk-encore-test
DEPLOY_NAME_SUFFIX=-test
DEPLOY_IMAGE_TAG=test
DEPLOY_WATCHTOWER_SCOPE=fktest

# Distinct host ports so prod (8080/5432/9000) and test can coexist.
DEPLOY_HOST_PORT_APP=18080
DEPLOY_HOST_PORT_POSTGRES=15432
DEPLOY_HOST_PORT_WATCHTOWER=9001

# The cloned cluster carries prod's database names, so these must be the
# same as in prod's env file (the defaults there are encore / embeddings).
# test-refresh.sh stops if the clone has no database of this name.
DEPLOY_PG_DATABASE=encore
DEPLOY_PG_EMBEDDINGS_DATABASE=embeddings

# Test-only RP identifier — passkeys registered against prod's RP_ID
# won't work here and vice versa.
DEPLOY_RP_ID=localhost
DEPLOY_RP_NAME=F4mil App (Test)
DEPLOY_RP_ORIGIN=http://localhost:18080
DEPLOY_APP_URL=http://localhost:18080

# ────────────────────────────────────────────────────────────────────────────
# The copy of production (read by scripts/host/test-refresh.sh)
# ────────────────────────────────────────────────────────────────────────────
# Marks this env file as the test stack on a copy of prod; the refresh
# refuses any env file without it. The app gets it from
# docker-compose.test.yml.
APP_ENVIRONMENT=dev

# The ZFS dataset the nightly backup snapshots (ZFS_DATASET of
# fk-encore-backup.sh) and the dataset the refresh clones it to. TEST_DATASET
# must contain "test", must not lie inside PROD_DATASET, and is destroyed
# and re-created on every refresh — make it a child dataset of its own
# (e.g. <pool>/<path>/f4mil_test/prod-copy) so the compose files and this
# env file next to it survive.
PROD_DATASET=tank/f4mil
TEST_DATASET=tank/f4mil_test/prod-copy

# Which tier of the backup's snapshots the refresh copies: daily- (newest,
# default), weekly- or monthly-. The clone pins its snapshot, so with a daily
# retention shorter than the refresh interval take weekly- and run the
# refresh on the backup's WEEKLY_SNAPSHOT_DOW, after the backup.
# TEST_SNAPSHOT_PREFIX=daily-

# Where prod's data directory sits inside the clone: the mountpoint of
# TEST_DATASET plus the same sub-path that prod's DEPLOY_DATA_ROOT has
# inside PROD_DATASET. Example: prod has DEPLOY_DATA_ROOT=/mnt/tank/f4mil/data,
# so test has /mnt/tank/f4mil_test/prod-copy/data. Must lie inside the
# mountpoint of TEST_DATASET; the refresh checks it.
DEPLOY_DATA_ROOT=/mnt/tank/f4mil_test/prod-copy/data

# Combines docker-compose.yml with your docker-compose.volumes.yml and the
# test overlay, so `docker compose up -d` needs no -f flags. Without it the
# volumes are undefined and compose stops with `volume "photos" is undefined`.
COMPOSE_FILE=docker-compose.yml:docker-compose.volumes.yml:docker-compose.test.yml

# The test app talks to prod's llm-service over prod's network
# (<prod COMPOSE_PROJECT_NAME>_default, `docker network ls`) and container
# name. Leave both at the default unless prod's project or container is
# named differently.
# TEST_PROD_NETWORK=fk-encore_default
# DEPLOY_LLM_SERVICE_URL=http://fk-encore-llm:8000

# Web page of the mail catcher: every mail the test app sends lands there.
DEPLOY_HOST_PORT_MAIL=18025

# ML CPU pinning — by default both stacks share the same P-core pool
# (0-11). The two stacks rarely run heavy inference at the same time, so
# this is normally fine. Override here if you want test pinned to a
# smaller / different range (e.g. only 0-3 while prod keeps 0-11).
# DEPLOY_ML_CPUSET=0-11
# CPU weighting (interactive receipt OCR vs background llm) inherits the prod
# defaults (4096 vs 512). Override per stack only if test and prod compete.
# DEPLOY_RECEIPT_OCR_CPU_SHARES=4096
# DEPLOY_LLM_CPU_SHARES=512

# Healthcheck start_period inherits the prod defaults from
# docker-compose.env.example (insightface 180s, embedding 600s, llm 600s).
# Uncomment to extend if first-time model downloads on this host are
# noticeably slower (NFS, slow link, etc).
# DEPLOY_INSIGHTFACE_START_PERIOD=180s
# DEPLOY_EMBEDDING_START_PERIOD=600s
# DEPLOY_LLM_START_PERIOD=600s
# DEPLOY_RECEIPT_OCR_START_PERIOD=600s

# ────────────────────────────────────────────────────────────────────────────
# Secrets (same conventions as prod — override defaults)
# ────────────────────────────────────────────────────────────────────────────
# The admin comes from the copy; these only matter if the copy has none.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=changeme-test

# Passwords of the cloned clusters. They carry prod's passwords; the refresh
# sets them to these over the container's local socket, so test needs none
# of prod's. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
GEO_DB_PASSWORD=

# REQUIRED — the stack refuses to start while this is empty, and so does
# the geo container. Generate one with: openssl rand -hex 32
GEO_SHARED_SECRET=
# REQUIRED — the stack refuses to start while this is empty. Watchtower's
# update API is backed by the Docker socket, so it must never run without
# a token. Generate one with: openssl rand -hex 32
WATCHTOWER_TOKEN=

# REQUIRED — the stack refuses to start while this is empty, and so do the
# five internal AI services it authenticates. Must be prod's value: the test
# app calls prod's llm-service (docker-compose.test.yml).
INTERNAL_SERVICE_SECRET=

# Mail goes to the mail catcher of docker-compose.test.yml, whatever is set
# here; only the sender is taken from this file.
SMTP_FROM=noreply-test@example.com

# Web Push, APNs, printing, SerpApi and EODHD get empty keys from
# docker-compose.test.yml; setting them here has no effect.

# Finance module — REQUIRED, and never prod's key: the copy carries prod's
# encrypted bank logins (the refresh deletes them, this is the second
# lock). Generate once:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# Losing it means every stored test bank credential has to be
# re-entered (acceptable for test data, painful in prod).
FINANCE_CREDENTIALS_KEY=

# ZKA product registration (PSD2). Placeholder is fine for test —
# production needs a registered ID from fints.org.
FINANCE_FINTS_PRODUCT_ID=dev-placeholder
FINANCE_FINTS_PRODUCT_VERSION=0.1.0

# Quotes come from Onvista (no key). EODHD and SerpApi stay without a key
# on test (docker-compose.test.yml).
FINANCE_QUOTE_PROVIDER=onvista
FINANCE_YAHOO_NEWS=on

# Backup endpoint protection — set if you want to exercise the
# backup flow on the test stack too. Generate with
# scripts/host/install-backup-hook.sh.
BACKUP_TOKEN=

# Feature flags — match prod unless you're testing a flag.
ENABLE_POI_DETECTION=true
