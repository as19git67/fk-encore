{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:setup": "msw init public/",
    "screenshot": "test-storybook --url http://localhost:6006 --config-dir .storybook",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:codegen": "playwright codegen http://localhost:5173/app/"
  },
  "dependencies": {
    "@primeuix/styles": "2.0.3",
    "@primeuix/themes": "^2.0.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vue/compiler-sfc": "^3.5.41",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/test-runner": "^0.22.0",
    "@storybook/vue3-vite": "^8.6.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^25.0.0",
    "msw": "^2.7.0",
    "msw-storybook-addon": "^2.0.4",
    "storybook": "^8.6.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.1.5"
  }
}
