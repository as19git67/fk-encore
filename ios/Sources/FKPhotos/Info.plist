<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.fk-encore.F4milPhotos.photoSync</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>F4mil Photos</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>f4milphotos</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
	<key>NSCameraUsageDescription</key>
	<string>Zum direkten Aufnehmen von Fotos für den Upload</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Um beim Start eines Trips den Ort für einen Namensvorschlag zu ermitteln und neue Fotos dem richtigen Reise-Album zuzuordnen</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Damit F4mil Photos während eines laufenden Trips vorschlagen kann, den Trip zu beenden, sobald du wieder zuhause bist – auch wenn die App gerade nicht geöffnet ist</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Zum Speichern aufgenommener Fotos in deiner Mediathek</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Zum Hochladen von Fotos in F4mil Photos</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
