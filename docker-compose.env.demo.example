# ──────────────────────────────────────────────────────────────────────────────
# fk-encore — Docker Compose DEMO deployment template
# ──────────────────────────────────────────────────────────────────────────────
#
# The demo runs as a third stack next to prod and test, from the same
# docker-compose.yml, follows `latest` through its own Watchtower, and fills
# itself with the demo data at its first boot (documentation/plans/
# demodaten.md, "Demo deployment"). Copy to `.env.demo` and bring up with:
#
#   docker compose --env-file .env.demo up -d
#
# Prod must be running first: the demo borrows prod's llm-service over
# prod's network (docker-compose.demo.yml).
#
# Only the values that differ from production are listed — everything else
# inherits the defaults in docker-compose.yml. See docker-compose.env.example
# for the full reference.

# ────────────────────────────────────────────────────────────────────────────
# Deployment identity
# ────────────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=fk-encore-demo
DEPLOY_NAME_SUFFIX=-demo
DEPLOY_IMAGE_TAG=latest
DEPLOY_WATCHTOWER_SCOPE=fkdemo

# Distinct host ports so prod (8080/5432/9000), test (18080/15432/9001) and
# the demo can coexist.
DEPLOY_HOST_PORT_APP=28080
DEPLOY_HOST_PORT_POSTGRES=25432
DEPLOY_HOST_PORT_WATCHTOWER=9002

DEPLOY_PG_DATABASE=encore_demo
DEPLOY_PG_EMBEDDINGS_DATABASE=embeddings_demo

# The public address of the demo. Passkeys are bound to RP_ID.
DEPLOY_RP_ID=localhost
DEPLOY_RP_NAME=F4mil App (Demo)
DEPLOY_RP_ORIGIN=http://localhost:28080
DEPLOY_APP_URL=http://localhost:28080

# Distinct bind-mount root. scripts/host/demo-reset.sh empties the data
# directories under it every night and refuses a root whose path does not
# contain "demo".
DEPLOY_DATA_ROOT=/mnt/data/fk-encore-demo

# The demo layer comes third: no llm-service of its own, DEMO_DATA=1.
COMPOSE_FILE=docker-compose.yml:docker-compose.volumes.yml:docker-compose.demo.yml

# ────────────────────────────────────────────────────────────────────────────
# Demo
# ────────────────────────────────────────────────────────────────────────────
# 1 = the full demo worded by the model; small = the small household of the
# E2E tests. Loads only while the system is untouched, so a restart does not
# load it twice. The nightly reset runs only where this is set.
DEMO_DATA=1

# Prod's network and its llm-service. The defaults fit a prod stack with
# COMPOSE_PROJECT_NAME=fk-encore and an empty DEPLOY_NAME_SUFFIX.
DEMO_PROD_NETWORK=fk-encore_default
DEPLOY_LLM_SERVICE_URL=http://fk-encore-llm:8000

# ────────────────────────────────────────────────────────────────────────────
# Secrets
# ────────────────────────────────────────────────────────────────────────────
# The demo admin owns the demo data. Visitors sign in with it, so use a
# password you are happy to publish, never prod's.
ADMIN_EMAIL=demo@example.com
ADMIN_NAME=Demo
ADMIN_PASSWORD=

# REQUIRED — must be THE SAME value as prod's: it is the bearer token the app
# sends to prod's llm-service.
INTERNAL_SERVICE_SECRET=

# REQUIRED — the same token as prod and test, because the image workflows
# send one WATCHTOWER_TOKEN to every stack. The demo's update URL goes into
# the repository secret WATCHTOWER_URL_DEMO (http://<host>:9002).
WATCHTOWER_TOKEN=

# REQUIRED — generate with: openssl rand -hex 32
GEO_SHARED_SECRET=
GEO_DB_PASSWORD=

# Own key, never prod's. Generate once:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
FINANCE_CREDENTIALS_KEY=
FINANCE_FINTS_PRODUCT_ID=dev-placeholder
FINANCE_FINTS_PRODUCT_VERSION=0.1.0

# The demo depot uses real index funds with real quotes; without a quote
# provider the depot is left out (and says why on the Systemstatus card).
FINANCE_QUOTE_PROVIDER=onvista
FINANCE_YAHOO_NEWS=on
EODHD_API_TOKEN=

# The demo sends no mail.
SMTP_HOST=
SMTP_FROM=noreply-demo@example.com

# Photos: the full demo fetches CC0 photos from api.openverse.org. Without
# access it draws them instead.
# OPENVERSE_API_URL=https://api.openverse.org
