# NVIDIA Blackwell (RTX 50 series) requires CUDA 12.8 or newer for native
# sm_120 code. This image is intentionally amd64-only; the CPU Dockerfile
# remains the portable default.
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS builder

WORKDIR /build

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.gpu.txt .

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.7.1 \
    && CMAKE_ARGS="-DGGML_CUDA=ON -DGGML_NATIVE=OFF -DCMAKE_CUDA_ARCHITECTURES=120" \
        /opt/venv/bin/pip install --no-cache-dir llama-cpp-python==0.3.31 \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.gpu.txt

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libgomp1 \
    python3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 568 apps \
    && useradd --uid 568 --gid 568 --create-home --shell /bin/bash apps

ENV PATH=/opt/venv/bin:$PATH \
    MODELS_DIR=/models \
    LLM_MODEL_PATH=/models/Qwen3-14B-Q4_K_M.gguf \
    SENTENCE_TRANSFORMERS_HOME=/models/st-cache \
    HF_HOME=/models/hf-cache \
    EMBEDDING_MODEL=intfloat/multilingual-e5-base \
    LLM_CTX=8192 \
    LLM_GPU_LAYERS=-1 \
    LLM_ACCELERATOR=cuda \
    LLM_EMBED_DEVICE=cuda \
    LOG_LEVEL=INFO \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY main.py ./
COPY download_model.sh /usr/local/bin/download_model.sh
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/download_model.sh /usr/local/bin/entrypoint.sh \
    && mkdir -p /models \
    && chown -R 568:568 /models /app /home/apps

EXPOSE 8000
USER 568:568

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
