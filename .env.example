# Initial admin user credentials
# These are used to seed the database on first startup.
# ⚠️  SECURITY: Change these values before deploying to production!
# ⚠️  NEVER commit real credentials to version control.
# Use `encore secret set --type local AdminPassword` for secrets instead of plain-text env vars.
# Generate a strong password: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
# WebAuthn / Passkey configuration
# RP_ID must match the domain where the app is served (no protocol, no port)
# RP_ORIGIN must match the full origin the browser uses (protocol + domain + port)
# ⚠️  SECURITY: RP_ORIGIN MUST use HTTPS in production – the service will refuse to start otherwise.
RP_ID=localhost
RP_NAME=Vivanty App
RP_ORIGIN=http://localhost:5173

# Photo storage configuration (optional — only needed for local `encore run`
# without Docker. In containers the defaults from photo/photo.service.ts and
# photo/libraries.service.ts apply: /mnt/data/photos, /mnt/data/thumbnails,
# /mnt/libraries). Uncomment and adjust if you want the dev process to write
# into a project-local directory instead.
#PHOTO_UPLOAD_DIR=uploads/photos
#PHOTO_THUMBNAIL_DIR=uploads/thumbnails
#PHOTO_LIBRARIES_ROOT=/mnt/libraries

# Face detection configuration
ENABLE_LOCAL_FACES=true
FACE_DISTANCE_THRESHOLD=0.42

# External Services configuration
INSIGHTFACE_SERVICE_URL=http://localhost:8000
EMBEDDING_SERVICE_URL=http://localhost:8001
# Local LLM service (Llama GGUF + multilingual-e5-base) used by the
# documents module for classification and embeddings.
LLM_SERVICE_URL=http://localhost:8002

# Label module
# Base URL of the CUPS server that exposes the label printer (e.g. a
# Raspberry Pi with a DYMO LabelWriter 450). The backend talks to it via
# IPP-over-HTTP to list queues and submit text/plain print jobs.
# Defaults to http://localhost:631 if unset.
CUPS_SERVER_URL=http://raspberrypi.local:631
# Left print margin in points (1 pt ≈ 4 px at 300 dpi) so the label text
# isn't flush against the left edge. Set to 0 to disable. Default: 1.
CUPS_LABEL_LEFT_MARGIN_PT=1
# Printable label width in mm, used to center text (columns = width × cpi).
# Set this to your label's printable width for accurate centering. Default: 85.
CUPS_LABEL_WIDTH_MM=85

# Documents module
# DOCUMENTS_DIR is the canonical archive (sha256-named PDFs in
# YYYY/YYYY-MM shards). DOCUMENTS_INBOX_DIR is a watched drop folder
# that the inbox-watcher imports from (typical use: a Raspberry Pi
# rsyncs scanned PDFs here over SSH — see
# scripts/host/README-documents-inbox.md).
DOCUMENTS_DIR=uploads/documents
DOCUMENTS_INBOX_DIR=uploads/documents-inbox
DOCUMENTS_MAX_SIZE_MB=50
# Optional: which user owns documents arriving via the inbox. Falls
# back to the first Admin if unset or unknown.
DOCUMENTS_INBOX_USER_EMAIL=
# OCR (only used when a PDF has no text layer)
DOCUMENTS_OCR_LANG=deu+eng
DOCUMENTS_OCR_DPI=200

# Database configuration
# DB_TYPE can be 'sqlite' or 'postgres'
DB_TYPE=postgres

# SMTP configuration for password reset emails
# If not set, reset tokens are logged to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# APP_URL is used for links in emails (defaults to RP_ORIGIN if unset)
APP_URL=http://localhost:5173

# SQLite configuration (only used when DB_TYPE=sqlite)
# Path to SQLite database file (relative to project root or absolute)
#SQLITE_DB_PATH=./data/app.db

# PostgreSQL configuration (only used when DB_TYPE=postgres)
# Connection string format: postgres://user:password@host:port/database
# Or specify individual parameters:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=encore
# Or use a full connection string (overrides individual parameters if set):
# POSTGRES_CONNECTION_STRING=postgres://user:password@host:port/database
