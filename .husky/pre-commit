#!/usr/bin/env sh
# ─── pre-commit ──────────────────────────────────────────────────────────────
# Runs the *fast* checks: anything that should reject a bad commit before it
# enters local history but completes in seconds, not minutes.
#
#   1. SFC parse — catches Vue template attribute / expression errors that
#      `vue-tsc --noEmit` is too permissive to report. (See scripts/check-sfc.mjs.)
#   2. Frontend type-check — `vue-tsc --noEmit` over the app config.
#   2b. Colour audit — styles must ask the theme, not name colours, or dark
#      mode breaks one view at a time. (See scripts/check-css-tokens.mjs.)
#   2c. Button labels — an icon button that says nothing is a button a screen
#      reader cannot announce. (See scripts/check-button-labels.mjs.)
#   3. iOS build number — derives CURRENT_PROJECT_VERSION from the commit
#      count whenever the commit touches ios/ (see the script's header).
#
# Skip with `git commit --no-verify` when you really need to (do not make a
# habit of it — the same checks run again in CI).
set -e

# --- 1. SFC parse ---------------------------------------------------------
node scripts/check-sfc.mjs

# --- 2. Frontend type-check ----------------------------------------------
# `--noEmit -p tsconfig.app.json` mirrors what CI's `vue-tsc -b && vite build`
# starts with, but without the slower build step. Catches TS errors in any
# .ts / .tsx / .vue script block under frontend/src.
( cd frontend && npx vue-tsc --noEmit -p tsconfig.app.json )

# --- 2b. Colour audit -----------------------------------------------------
# Only the staged styles: the whole tree takes a second, one commit's worth
# takes none, and a file nobody touched is not this commit's problem.
STAGED_STYLES=$(git diff --cached --name-only --diff-filter=ACM -- 'frontend/src/**/*.vue' 'frontend/src/**/*.css')
if [ -n "$STAGED_STYLES" ]; then
  # shellcheck disable=SC2086 -- the list is newline-separated paths, no globs
  node scripts/check-css-tokens.mjs $STAGED_STYLES
fi

# --- 2c. Button labels ----------------------------------------------------
# Same idea, same staged files: an icon button needs an aria-label or a
# tooltip, or nothing announces what it does.
STAGED_VUE=$(git diff --cached --name-only --diff-filter=ACM -- 'frontend/src/**/*.vue')
if [ -n "$STAGED_VUE" ]; then
  # shellcheck disable=SC2086 -- the list is newline-separated paths, no globs
  node scripts/check-button-labels.mjs $STAGED_VUE
fi

# --- 3. iOS build number --------------------------------------------------
# A no-op for every commit that does not touch ios/. Amends the staged
# Xcode project in place, so the new number is part of this commit.
sh scripts/sync-ios-build-number.sh
