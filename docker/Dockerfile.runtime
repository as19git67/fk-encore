# syntax=docker/dockerfile:1.7
#
# Runtime wrapper around the image produced by `encore build docker`.
#
# Encore.ts' own build pipeline compiles the app, bundles node_modules, and
# emits an image based on --base=node:24-bookworm-slim. That image has no
# concept of TrueNAS SCALE's apps user, no bind-mount directories, and does
# not know about our pre-built frontend SPA. This wrapper adds exactly that
# on top and bakes APP_BUILD_NUMBER in for the /api/build-info endpoint.
#
# Inputs:
#   BASE_IMAGE   - tag of the image produced by `encore build docker`
#   BUILD_NUMBER - value exposed to the app as APP_BUILD_NUMBER (e.g. run-sha)
#
# The CMD/ENTRYPOINT is inherited from the Encore base image unchanged.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

# postgresql-client provides pg_dump and pg_restore, used by the backup
# service (backup/pg-dump.ts) for the fast-path DB dump during a backup
# run and for the restore-on-startup hook.
#
# We pull postgresql-client-18 from the PostgreSQL Global Development Group
# (PGDG) apt repository rather than Debian's default, because Bookworm only
# ships postgresql-client 15 and pg_dump refuses to dump from a server whose
# major version is newer than the client (the production database runs
# PostgreSQL 18).
#
# tesseract-ocr (+ language packs) and poppler-utils support the documents
# pipeline:
#   - `pdftoppm` (poppler-utils) rasterizes scanned PDFs into PNGs.
#   - `tesseract` reads those PNGs (deu+eng) when the PDF has no text layer.
#     It also emits a per-page searchable PDF (image + invisible positioned
#     text layer) that `pdfunite` (poppler-utils) merges into one sandwich
#     PDF, so scans become selectable in the viewer and on download.
#   - `qpdf` rewrites PDFs whose cross-reference table is missing or
#     truncated so poppler can rasterize them. See the repair fallback in
#     `documents/text-extract.ts`.
#   - `ghostscript` (`gs`) re-renders severely broken PDFs that qpdf can't
#     fix (missing trailer + corrupted xref). Slower but more resilient.
# All of these are invoked by `documents/text-extract.ts`.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    install -d /usr/share/postgresql-common/pgdg; \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc; \
    . /etc/os-release; \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        postgresql-client-18 \
        tesseract-ocr \
        tesseract-ocr-deu \
        tesseract-ocr-eng \
        poppler-utils \
        qpdf \
        ghostscript; \
    apt-get purge -y --auto-remove curl gnupg; \
    rm -rf /var/lib/apt/lists/*

# Create the TrueNAS SCALE "apps" group/user (UID/GID 568) if they are not
# already present in the Encore base. Also create the bind-mount targets and
# hand them to the apps user, matching the permissions the host expects.
RUN set -eux; \
    if ! getent group  568 >/dev/null; then groupadd -g 568 apps;  fi; \
    if ! getent passwd 568 >/dev/null; then useradd  -u 568 -g 568 -m -s /bin/bash apps; fi; \
    mkdir -p /mnt/data/photos /mnt/data/thumbnails /mnt/data/documents /mnt/data/documents-inbox /mnt/backup /app/data /srv/frontend/dist; \
    chown -R 568:568 /mnt/data /mnt/backup /app/data /srv/frontend

# Pre-built SPA assets. The host-side CI/CD runs `npm run build` in frontend/
# before calling `docker build`, so frontend/dist is populated.
COPY --chown=568:568 frontend/dist/ /srv/frontend/dist/

# Host-side backup hook: the three files the TrueNAS host needs (installer,
# daily driver script, README) are shipped inside the image and copied onto
# the backup volume on every container start by backup/startup.ts. That way
# the host always has the version that matches the running image, without
# the admin having to clone the fk-encore repo on the host.
COPY --chown=568:568 scripts/host/install-backup-hook.sh \
                     scripts/host/fk-encore-backup.sh \
                     scripts/host/format-backup-log.sh \
                     scripts/host/README.md \
                     /opt/fk-encore/host-scripts/
RUN chmod 0755 /opt/fk-encore/host-scripts/*.sh

ARG BUILD_NUMBER=dev
ENV APP_BUILD_NUMBER=${BUILD_NUMBER} \
    FRONTEND_DIST_DIR=/srv/frontend/dist \
    PORT=8080

EXPOSE 8080

USER 568:568
