# ──────────────────────────────────────────────────────────────────────────────
# Vivanty – Docker Compose Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust the values for your environment.
#
#   cp docker-compose.env.example .env
#   docker compose up -d
#
# ──────────────────────────────────────────────────────────────────────────────

# ── Main Application ─────────────────────────────────────────────────────────

# Port the app is accessible on the host
APP_PORT=8080

# Initial admin account (created on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me-please

# WebAuthn / Passkey configuration
# RP_ID = domain without protocol/port, RP_ORIGIN = full URL the browser uses
RP_ID=localhost
RP_NAME=Vivanty App
RP_ORIGIN=http://localhost:8080

# Face detection
ENABLE_LOCAL_FACES=true
FACE_DISTANCE_THRESHOLD=0.42

# ── SMTP (password reset emails) ─────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email sending (tokens are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# APP_URL is used for links in emails (reset link = APP_URL/forgot-password?token=...)
APP_URL=http://localhost:8080

# ── Embedding Service ────────────────────────────────────────────────────────

# Models (defaults are lightweight CPU-friendly choices)
CLIP_MODEL_NAME=xlm-roberta-large-ViT-H-14
CLIP_PRETRAINED=frozen_laion5b_s13b_b90k
DINO_MODEL_NAME=facebook/dinov2-base
EMBEDDING_LOG_LEVEL=INFO

# Password for the embedding service's PostgreSQL database
EMBEDDING_DB_PASSWORD=postgres

# ── Backup ───────────────────────────────────────────────────────────────────
# Shared secret for the /internal/backup/* endpoints. Must match
# /etc/fk-encore/backup-token on the host. Generate both with:
#   sudo scripts/host/install-backup-hook.sh
# Leaving this empty disables the endpoints (they respond with 401).
BACKUP_TOKEN=

# Optional — override the auto-stop safety timer (default 30 minutes).
# BACKUP_AUTO_STOP_MS=1800000

# Optional — restrict /internal/backup/* to a custom set of source CIDRs.
# Defence-in-depth: even if BACKUP_TOKEN leaks, requests from outside
# the list are rejected. Leave empty to use the built-in defaults:
# loopback (127.0.0.0/8, ::1/128) + RFC1918 (10/8, 172.16/12, 192.168/16)
# + IPv6 ULA (fc00::/7). Those already cover host → container traffic
# via the Docker bridge. Only override if you have a non-standard setup
# (e.g. a reverse proxy on a specific subnet).
# BACKUP_ALLOW_CIDRS=10.0.0.0/8,192.168.1.0/24

# Set to "true" if /internal/backup/* is reached through a trusted
# reverse proxy that sets X-Forwarded-For — the left-most entry is
# then used as the client IP for the CIDR check. Leave "false" (or
# unset) otherwise; the socket peer address is used directly.
# BACKUP_TRUST_XFF=false
