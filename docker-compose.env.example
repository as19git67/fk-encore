# ──────────────────────────────────────────────────────────────────────────────
# fk-encore — Docker Compose production deployment template
# ──────────────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` next to docker-compose.yml and adjust the
# marked values, then bring up the stack with:
#
#   cp docker-compose.env.example .env
#   # edit .env — at minimum set ADMIN_PASSWORD, WATCHTOWER_TOKEN,
#   # and DEPLOY_DATA_ROOT
#   docker compose up -d
#
# To run a second deployment alongside (e.g. a PR-image test stack on
# a separate port range), copy `docker-compose.env.test.example` to
# `.env.test` and bring that one up with:
#
#   docker compose --env-file .env.test up -d
#
# Note: a separate `.env.example` exists in this directory for local
# `encore run` development (no Docker). Different file, different
# defaults, different intended consumer.
#
# All `DEPLOY_*` variables control compose-level wiring (container
# names, host ports, image tags, volume bind paths). Application-level
# env (SMTP_*, VAPID_*, BACKUP_*, FINANCE_*, …) keep their normal
# names so the same secret value can be reused across stacks.

# ────────────────────────────────────────────────────────────────────────────
# Deployment identity
# ────────────────────────────────────────────────────────────────────────────
# Compose project — isolates docker resources between deployments.
COMPOSE_PROJECT_NAME=fk-encore

# Suffix appended to every container name (fk-encore-app${DEPLOY_NAME_SUFFIX}).
# Empty for the primary deployment; a second stack uses e.g. `-test`.
DEPLOY_NAME_SUFFIX=

# Image tag — `latest` for production, `test` for PR-built images.
DEPLOY_IMAGE_TAG=latest

# Watchtower scope label. Watchtower only updates containers carrying
# the scope label matching its own; pick a distinct value per deployment.
DEPLOY_WATCHTOWER_SCOPE=fkprod

# Host ports — unique per deployment.
DEPLOY_HOST_PORT_APP=8080
DEPLOY_HOST_PORT_POSTGRES=5432
DEPLOY_HOST_PORT_WATCHTOWER=9000

# Postgres database names — each deployment owns its own DB on the
# shared postgres container.
DEPLOY_PG_DATABASE=encore
DEPLOY_PG_EMBEDDINGS_DATABASE=embeddings

# WebAuthn / passkey identifiers. RP_ID must be the bare hostname of
# RP_ORIGIN without scheme or port; passkeys are bound to RP_ID for
# life, so don't change this after the first user registers a key.
# RP_ORIGIN MUST use HTTPS in production — the service refuses to
# start otherwise.
DEPLOY_RP_ID=localhost
DEPLOY_RP_NAME=F4mil App
DEPLOY_RP_ORIGIN=http://localhost:8080
DEPLOY_APP_URL=http://localhost:8080

# Bind-mount root for every persisted volume. Absolute path is recommended
# so backups + restores don't depend on the compose file's working dir.
DEPLOY_DATA_ROOT=/mnt/data/fk-encore

# CPU pinning for the ML services (insightface, embedding_service,
# llm_service, receipt_ocr_service). Pin to the P-core threads on Intel 12th/13th/14th Gen
# hybrid CPUs. On a 12600K the typical Linux topology is: P-core threads =
# logical CPUs 0-11, E-cores = 12-15. Including E-cores in the OMP pool
# causes load imbalance (P-cores wait for slower E-cores at sync points),
# so excluding them is usually a net win even though it surrenders 4 cores.
# Verify the mapping on the host with `lscpu --extended` and adjust if the
# BIOS / kernel laid the cores out differently. On a non-hybrid CPU you
# typically want all available threads, e.g. `0-15` on a 16-thread box.
DEPLOY_ML_CPUSET=0-11

# Relative CPU weight (cgroup cpu.shares / cpu.weight) for the ML services
# sharing the P-core pool above. Higher weight wins a bigger slice of CPU
# *only under contention* — an idle service never holds cores back from the
# others. The receipt OCR extraction is interactive and bursty (it runs while
# a user waits on a receipt scan), so it gets a high weight to displace the
# background llm_service while it runs; the llm runs at a low weight and
# simply slows down for the duration of a scan instead of being stopped.
# Default 1024 applies to any service without an explicit value (insightface,
# embedding_service). Set both to 1024 to disable the bias.
DEPLOY_RECEIPT_OCR_CPU_SHARES=4096
DEPLOY_LLM_CPU_SHARES=512

# Healthcheck `start_period` for the ML services. During this
# window a failing healthcheck doesn't count as unhealthy, so the app's
# `depends_on: service_healthy` gate waits instead of bailing out with
# `dependency failed to start` while the model is still loading.
#
# Defaults cover a cold first start (model needs downloading + initial
# load on a CPU-only box). Trim them once the on-disk caches are warm
# if you want faster `docker compose up` cycles, or extend them on slow
# storage / slow bandwidth.
DEPLOY_INSIGHTFACE_START_PERIOD=180s
DEPLOY_EMBEDDING_START_PERIOD=600s
DEPLOY_LLM_START_PERIOD=600s
DEPLOY_RECEIPT_OCR_START_PERIOD=600s

# ────────────────────────────────────────────────────────────────────────────
# Application secrets (override the changeme defaults!)
# ────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=changeme

# Watchtower HTTP API token — shared secret with whatever calls the
# update webhook (typically a GitHub Actions deploy step).
WATCHTOWER_TOKEN=

# Generate once: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# Losing this key means every stored bank credential has to be re-entered.
FINANCE_CREDENTIALS_KEY=

# ZKA product registration (PSD2). Placeholder works for self-host;
# production needs a registered ID from fints.org.
FINANCE_FINTS_PRODUCT_ID=dev-placeholder
FINANCE_FINTS_PRODUCT_VERSION=0.1.0

# Backup endpoint protection — generate with scripts/host/install-backup-hook.sh.
# Leaving this empty disables /internal/backup/* (responds 401).
BACKUP_TOKEN=

# Web Push (optional) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# SMTP for password reset emails (empty = log tokens to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ────────────────────────────────────────────────────────────────────────────
# Feature flags & tuning (sane defaults; override only as needed)
# ────────────────────────────────────────────────────────────────────────────
# Enable per-photo POI detection. Off by default — turn on once at
# least one OSM region has been imported via the admin UI.
ENABLE_POI_DETECTION=false

# geo service (reverse-geocoding + POI lookup). The compose stack
# already wires the URL via service DNS; override only when running
# the app outside compose. GEO_SHARED_SECRET is optional — when set,
# every call to the geo container must carry `Authorization: Bearer
# <secret>`. GEO_DB_PASSWORD is the Postgres superuser password for
# the bundled PostGIS container.
GEO_SERVICE_URL=http://geo:8080
GEO_SHARED_SECRET=
GEO_DB_PASSWORD=postgres

# osm2pgsql tuning for region imports. Cache scales with PBF size;
# raise on hosts with spare RAM.
GEO_OSM2PGSQL_CACHE_MB=2000
GEO_OSM2PGSQL_PROCS=2

# embedding_service inference backend. "torch" (default) needs no extra
# setup; "onnx" requires running optimize_models.sh once to populate
# the INT8 artefacts in the embedding_models volume.
EMBED_BACKEND=torch

# Receipt OCR service (PaddleOCR + Qwen2.5-3B for structured extraction).
# Set to 1 to skip the LLM step and use PaddleOCR + regex only (lighter).
RECEIPT_OCR_REGEX_ONLY=0
# OCR language for PaddleOCR (default: latin — covers German/English).
#RECEIPT_OCR_LANG=latin
# Contour-based auto-crop + perspective correction of the receipt before OCR
# (default on). Set to 0 to disable if it mis-crops your photos.
#RECEIPT_OCR_AUTOCROP=1
# LLM context window size for the small extraction model.
#RECEIPT_OCR_LLM_CTX=4096
