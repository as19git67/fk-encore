# ──────────────────────────────────────────────────────────────────────────────
# Vivanty – Docker Compose Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust the values for your environment.
#
#   cp docker-compose.env.example .env
#   docker compose up -d
#
# ──────────────────────────────────────────────────────────────────────────────

# ── Main Application ─────────────────────────────────────────────────────────

# Port the app is accessible on the host
APP_PORT=8080

# Initial admin account (created on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me-please

# WebAuthn / Passkey configuration
# RP_ID = domain without protocol/port, RP_ORIGIN = full URL the browser uses
RP_ID=localhost
RP_NAME=Vivanty App
RP_ORIGIN=http://localhost:8080

# Face detection
ENABLE_LOCAL_FACES=true
FACE_DISTANCE_THRESHOLD=0.42

# External photo libraries (issue #75). PHOTO_LIBRARIES_ROOT is the directory
# inside the container that holds mounted library volumes. Every path
# registered via the /libraries API must live under this root.
PHOTO_LIBRARIES_ROOT=/mnt/libraries

# ── SMTP (password reset emails) ─────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email sending (tokens are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# APP_URL is used for links in emails (reset link = APP_URL/forgot-password?token=...)
APP_URL=http://localhost:8080

# ── Embedding Service ────────────────────────────────────────────────────────

# Models (defaults are lightweight CPU-friendly choices)
CLIP_MODEL_NAME=xlm-roberta-large-ViT-H-14
CLIP_PRETRAINED=frozen_laion5b_s13b_b90k
DINO_MODEL_NAME=facebook/dinov2-base
EMBEDDING_LOG_LEVEL=INFO

# Password for the embedding service's PostgreSQL database
EMBEDDING_DB_PASSWORD=postgres

# ── Backup ───────────────────────────────────────────────────────────────────
# Shared secret for the /internal/backup/* endpoints. Must match
# /etc/fk-encore/backup-token on the host. Generate both with:
#   sudo scripts/host/install-backup-hook.sh
# Leaving this empty disables the endpoints (they respond with 401).
BACKUP_TOKEN=

# Optional — override the auto-stop safety timer (default 30 minutes).
# BACKUP_AUTO_STOP_MS=1800000

# Optional — restrict /internal/backup/* to a custom set of source CIDRs.
# Defence-in-depth: even if BACKUP_TOKEN leaks, requests from outside
# the list are rejected. Leave empty to use the built-in defaults:
# loopback (127.0.0.0/8, ::1/128) + RFC1918 (10/8, 172.16/12, 192.168/16)
# + IPv6 ULA (fc00::/7). Those already cover host → container traffic
# via the Docker bridge. Only override if you have a non-standard setup
# (e.g. a reverse proxy on a specific subnet).
# BACKUP_ALLOW_CIDRS=10.0.0.0/8,192.168.1.0/24

# By default the CIDR check reads the left-most `X-Forwarded-For` entry
# as the client IP. This is required under Encore.ts, whose Rust HTTP
# layer proxies requests into Node and relays the real peer IP via XFF
# (the socket peer inside the Node handler is the internal proxy). Set
# to "false" only in test rigs that run the handler without Encore.
# BACKUP_TRUST_XFF=true

# ── Web Push (optional) ──────────────────────────────────────────────────────
# Browser push notifications for feed events. Generate the keypair once
# with `npx web-push generate-vapid-keys`, then paste the values below.
# VAPID_SUBJECT must be a `mailto:` or `https://` URL identifying the
# server operator. Leaving any of the three empty keeps push silently
# disabled (the Profile page reports "not configured"). See
# docs/push-notifications.md for the full setup.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Finance module ───────────────────────────────────────────────────────────
# AES-256-GCM master key for encrypting bank PINs stored in
# finance_bankcontact.credentials_encrypted. 32 random bytes, base64.
# Generate once with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# Rotation requires a re-encrypt script + redeploy. Losing the key means
# every stored bank credential becomes unrecoverable and has to be re-entered.
FINANCE_CREDENTIALS_KEY=

# ZKA product registration (mandatory for FinTS PSD2):
# https://www.fints.org/de/hersteller/produktregistrierung
# Dev/test may use any placeholder; production must use a registered id.
FINANCE_FINTS_PRODUCT_ID=dev-placeholder
FINANCE_FINTS_PRODUCT_VERSION=0.1.0
